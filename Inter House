<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Inter-House Tournament Manager</title>
<style>
:root{--bg:#f4f7fb;--card:#fff;--text:#172033;--muted:#6b7280;--line:#e5e7eb;--accent:#2563eb;--danger:#dc2626}
*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,Arial,sans-serif;background:var(--bg);color:var(--text)}
header{background:#111827;color:white;padding:20px 24px;position:sticky;top:0;z-index:10;box-shadow:0 3px 15px #0002}
header h1{margin:0 0 4px;font-size:24px}header p{margin:0;color:#cbd5e1;font-size:14px}
nav{display:flex;gap:8px;overflow:auto;padding:12px 20px;background:#fff;border-bottom:1px solid var(--line)}
nav button,.sport-btn,.tab{border:0;background:#eef2ff;color:#334155;padding:10px 14px;border-radius:10px;font-weight:700;cursor:pointer;white-space:nowrap}
nav button.active,.sport-btn.active,.tab.active{background:var(--accent);color:white}
main{max-width:1200px;margin:auto;padding:20px}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px}
button{font:inherit}.primary{background:var(--accent);color:white;border:0;padding:10px 14px;border-radius:9px;cursor:pointer;font-weight:700}
.secondary{background:white;border:1px solid var(--line);padding:10px 14px;border-radius:9px;cursor:pointer}
.danger{color:var(--danger);border-color:#fecaca}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 4px 14px #00000008}
.card h2,.card h3{margin-top:0}.stat{font-size:28px;font-weight:800}.muted{color:var(--muted)}
table{width:100%;border-collapse:collapse;background:white;border-radius:14px;overflow:hidden}th,td{padding:11px 10px;border-bottom:1px solid var(--line);text-align:center}th{background:#f8fafc;font-size:13px}td:first-child,th:first-child{text-align:left}
.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}.form input,.form select{width:100%;padding:10px;border:1px solid #d1d5db;border-radius:8px;background:white}
.score-row{display:grid;grid-template-columns:1fr 90px 90px 1fr 90px;gap:8px;align-items:center;padding:10px;border-bottom:1px solid var(--line)}.score-row input{width:100%;padding:8px;border:1px solid #d1d5db;border-radius:7px}
.badge{display:inline-block;padding:4px 8px;border-radius:99px;background:#e0e7ff;color:#3730a3;font-size:12px;font-weight:700}
.empty{text-align:center;padding:35px;color:var(--muted)}
.small{font-size:12px}.hidden{display:none}.view-mode .admin-only{display:none}
@media(max-width:650px){main{padding:12px}.score-row{grid-template-columns:1fr 65px 65px 1fr}.score-row button{grid-column:1/-1}.score-row .vs{display:none}}
.modal{display:none;position:fixed;inset:0;background:#0008;z-index:100;align-items:center;justify-content:center;padding:20px}
.modal.show{display:flex}.login-box{background:#fff;border-radius:16px;padding:24px;width:min(420px,100%);box-shadow:0 20px 60px #0004}
.login-box input{width:100%;padding:12px;border:1px solid #d1d5db;border-radius:9px;margin:10px 0 12px}
.admin-pill{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border-radius:999px;background:#dcfce7;color:#166534;font-size:12px;font-weight:800}
.view-pill{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border-radius:999px;background:#f1f5f9;color:#475569;font-size:12px;font-weight:800}
''</style>
</head>
<body>
<div id="loginModal" class="modal">
  <div class="login-box">
    <h2>🔐 Admin Login</h2>
    <p class="muted">Only administrators can edit tournament data.</p>
    <input id="adminPassword" type="password" placeholder="Admin password" autocomplete="current-password">
    <button class="primary" onclick="adminLogin()">Login</button>
    <button class="secondary" onclick="closeLogin()">Cancel</button>
    <p id="loginError" class="small" style="color:#dc2626"></p>
  </div>
</div>
<header>
<h1>🏆 Inter-House Tournament Manager</h1>
<p>Volleyball • Football • Kho Kho • Table Tennis • Badminton • Chess • Carroms</p>
</header>

<nav id="sports"></nav>

<main>
<div class="toolbar">
<button class="primary admin-only" onclick="showSetup()">⚙ Tournament Setup</button>
<button class="secondary" onclick="showTab('standings')">📊 Points Table</button>
<button class="secondary" onclick="showTab('fixtures')">📅 Fixtures</button>
<button class="secondary" onclick="exportData()">⬇ Export</button>
<button class="secondary" onclick="document.getElementById('importFile').click()">⬆ Import</button>
<input id="importFile" type="file" accept=".json" hidden onchange="importData(event)">
<span id="authStatus" class="view-pill">👁 View only</span>
<button id="loginBtn" class="secondary" onclick="showLogin()">🔐 Admin Login</button>
<button id="logoutBtn" class="secondary hidden" onclick="adminLogout()">Logout</button>
</div>

<div id="app"></div>
</main>

<script>
const SPORTS=["Volleyball","Football","Kho Kho","Table Tennis","Badminton","Chess","Carroms"];
const defaultTeams=["Ganga","Yamuna","Krishna","Kaveri"];
const ADMIN_PASSWORD = "19842010"; // Change this before publishing on GitHub.
let isAdmin = sessionStorage.getItem("tournamentAdmin")==="1";
const state=JSON.parse(localStorage.getItem("tourneyData")||"null")||{
  currentSport:"Volleyball",teams:defaultTeams,fixtures:[],tab:"dashboard",
  points:{}, settings:{win:3,draw:1,loss:0}
};
function requireAdmin(){
  if(isAdmin) return true;
  showLogin();
  return false;
}
function showLogin(){
  document.getElementById("loginModal").classList.add("show");
  document.getElementById("adminPassword").focus();
}
function closeLogin(){
  document.getElementById("loginModal").classList.remove("show");
  document.getElementById("loginError").textContent="";
}
function adminLogin(){
  const p=document.getElementById("adminPassword").value;
  if(p===ADMIN_PASSWORD){
    isAdmin=true;
    sessionStorage.setItem("tournamentAdmin","1");
    closeLogin();
    updateAuthUI();
    render();
  }else{
    document.getElementById("loginError").textContent="Incorrect password.";
  }
}
function adminLogout(){
  isAdmin=false;
  sessionStorage.removeItem("tournamentAdmin");
  updateAuthUI();
  render();
}
function updateAuthUI(){
  document.body.classList.toggle("view-mode",!isAdmin);
  const s=document.getElementById("authStatus");
  if(!s)return;
  s.className=isAdmin?"admin-pill":"view-pill";
  s.textContent=isAdmin?"🔓 Admin mode":"👁 View only";
  document.getElementById("loginBtn").classList.toggle("hidden",isAdmin);
  document.getElementById("logoutBtn").classList.toggle("hidden",!isAdmin);
}
function save(){localStorage.setItem("tourneyData",JSON.stringify(state))}
function esc(s){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function init(){
  updateAuthUI();
 document.getElementById("sports").innerHTML=SPORTS.map(s=>`<button class="${s===state.currentSport?'active':''}" onclick="setSport('${s}')">${s}</button>`).join("");
 render();
}
function setSport(s){\n  if(!requireAdmin())return;state.currentSport=s;state.tab="dashboard";save();init()}
function showTab(t){state.tab=t;render()}
function render(){
  updateAuthUI();
 const s=state.currentSport;
 if(state.tab==="standings") return renderStandings();
 if(state.tab==="fixtures") return renderFixtures();
 document.getElementById("app").innerHTML=`
 <div class="grid">
  <div class="card"><span class="badge">${s}</span><h2>Dashboard</h2><div class="stat">${state.teams.length}</div><div class="muted">Teams / Houses</div></div>
  <div class="card"><h2>Matches</h2><div class="stat">${state.fixtures.filter(f=>f.sport===s).length}</div><div class="muted">Fixtures created</div></div>
  <div class="card"><h2>Completed</h2><div class="stat">${state.fixtures.filter(f=>f.sport===s&&f.played).length}</div><div class="muted">Results entered</div></div>
 </div>
 <br>
 <div class="card"><h2>Quick actions</h2>
 <div class="toolbar">
 <button class="primary admin-only" onclick="generateFixtures()">➕ Generate Round Robin</button>
 <button class="secondary" onclick="showTab('fixtures')">Enter Results</button>
 <button class="secondary" onclick="showTab('standings')">View Standings</button>
 </div>
 <p class="muted small">Round-robin generates every house-vs-house matchup once for the selected sport. You can edit scores later.</p>
 </div>`;
}
function pointsFor(t){
 let p={team:t,pl:0,w:0,d:0,l:0,for:0,against:0,pts:0};
 state.fixtures.filter(f=>f.sport===state.currentSport&&f.played).forEach(f=>{
   if(f.a!==t&&f.b!==t)return;
   const isA=f.a===t, us=Number(isA?f.sa:f.sb), them=Number(isA?f.sb:f.sa);
   p.pl++;p.for+=us;p.against+=them;
   if(us>them){p.w++;p.pts+=Number(state.settings.win)}
   else if(us===them){p.d++;p.pts+=Number(state.settings.draw)}
   else p.l++;
 });
 return p;
}
function renderStandings(){
 const rows=state.teams.map(pointsFor).sort((a,b)=>b.pts-a.pts||(b.for-b.against)-(a.for-a.against));
 document.getElementById("app").innerHTML=`<div class="card"><h2>${state.currentSport} — Points Table</h2>
 <div class="muted small">Points: Win ${state.settings.win} • Draw ${state.settings.draw} • Loss ${state.settings.loss}</div><br>
 <table><thead><tr><th>#</th><th>House</th><th>MP</th><th>W</th><th>D</th><th>L</th><th>For</th><th>Against</th><th>Diff</th><th>Pts</th></tr></thead>
 <tbody>${rows.map((r,i)=>`<tr><td>${i+1}</td><td><b>${esc(r.team)}</b></td><td>${r.pl}</td><td>${r.w}</td><td>${r.d}</td><td>${r.l}</td><td>${r.for}</td><td>${r.against}</td><td>${r.for-r.against}</td><td><b>${r.pts}</b></td></tr>`).join("")}</tbody></table></div>`;
}
function renderFixtures(){
 const fs=state.fixtures.filter(f=>f.sport===state.currentSport);
 document.getElementById("app").innerHTML=`<div class="card"><div class="toolbar"><h2 style="margin:auto 0 auto 0">${state.currentSport} — Fixtures</h2><button class="primary admin-only" onclick="generateFixtures()">Generate Round Robin</button><button class="secondary danger admin-only" onclick="clearSport()">Clear Sport</button></div>
 ${fs.length?fs.map((f,i)=>`<div class="score-row">
 <b>${esc(f.a)}</b><input type="number" min="0" value="${f.played?f.sa:''}" placeholder="0" id="a${i}">
 <span class="vs">VS</span><input type="number" min="0" value="${f.played?f.sb:''}" placeholder="0" id="b${i}">
 <b>${esc(f.b)}</b><button class="primary admin-only" onclick="saveScore(${state.fixtures.indexOf(f)},'a${i}','b${i}')">${f.played?'Update':'Save Result'}</button>
 </div>`).join(""):`<div class="empty">No fixtures yet. Click <b>Generate Round Robin</b>.</div>`}</div>`;
}
function generateFixtures(){\n  if(!requireAdmin())return;
 const existing=state.fixtures.filter(f=>f.sport===state.currentSport);
 if(existing.length&&!confirm("This will add another full round-robin schedule. Continue?"))return;
 for(let i=0;i<state.teams.length;i++)for(let j=i+1;j<state.teams.length;j++)
   state.fixtures.push({sport:state.currentSport,a:state.teams[i],b:state.teams[j],played:false,sa:"",sb:""});
 save();showTab("fixtures");
}
function saveScore(index,aId,bId){\n  if(!requireAdmin())return;
 const a=document.getElementById(aId).value,b=document.getElementById(bId).value;
 if(a===""||b===""){alert("Enter both scores.");return}
 state.fixtures[index].sa=Number(a);state.fixtures[index].sb=Number(b);state.fixtures[index].played=true;
 save();renderFixtures();
}
function showSetup(){
 document.getElementById("app").innerHTML=`<div class="card"><h2>Tournament Setup</h2>
 <h3>Houses / Teams</h3><div class="form"><input id="teams" value="${esc(state.teams.join(", "))}" placeholder="Ganga, Yamuna, Krishna, Kaveri"></div>
 <br><h3>Points system</h3><div class="form">
 <label>Win<input id="win" type="number" value="${state.settings.win}"></label>
 <label>Draw<input id="draw" type="number" value="${state.settings.draw}"></label>
 <label>Loss<input id="loss" type="number" value="${state.settings.loss}"></label></div><br>
 <button class="primary admin-only" onclick="saveSetup()">Save Setup</button></div>`;
}
function saveSetup(){\n  if(!requireAdmin())return;
 const teams=document.getElementById("teams").value.split(",").map(x=>x.trim()).filter(Boolean);
 if(teams.length<2){alert("Add at least 2 teams/houses.");return}
 state.teams=teams;state.settings={win:Number(document.getElementById("win").value),draw:Number(document.getElementById("draw").value),loss:Number(document.getElementById("loss").value)};
 save();init();
}
function clearSport(){\n  if(!requireAdmin())return;
 if(!confirm("Delete all fixtures and results for "+state.currentSport+"?"))return;
 state.fixtures=state.fixtures.filter(f=>f.sport!==state.currentSport);save();renderFixtures();
}
function exportData(){
 const blob=new Blob([JSON.stringify(state,null,2)],{type:"application/json"});
 const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="tournament-data.json";a.click();URL.revokeObjectURL(a.href);
}
function importData(e){\n  if(!requireAdmin())return;
 const file=e.target.files[0];if(!file)return;
 const r=new FileReader();r.onload=()=>{try{Object.assign(state,JSON.parse(r.result));save();init()}catch{alert("Invalid tournament file.")}};r.readAsText(file);
}
init();
</script>
</body>
</html>
